<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/neutral_white"
    app:cardCornerRadius="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp">

        <!-- Product Image on the left side -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/productImage"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_gravity="center_vertical"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_image_gray"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:contentDescription="Product Image" />

        <!-- Product Details Section on the right side -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <!-- Product Title and Favorite Button aligned to the end -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/productTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Product Title"
                    android:textSize="16sp"
                    android:layout_marginEnd="8dp"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="@color/neutral_black"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <ImageButton
                    android:id="@+id/favoriteButton"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/circle_background"
                    android:backgroundTint="@color/neutral_grey"
                    android:src="@drawable/ic_favorites_white_small"
                    android:contentDescription="Favorite Icon" />
            </LinearLayout>

            <!-- Location -->
<!--            <LinearLayout-->
<!--                android:id="@+id/locationLayout"-->
<!--                android:layout_width="wrap_content"-->
<!--                android:layout_height="wrap_content"-->
<!--                android:orientation="horizontal"-->
<!--                android:gravity="center_vertical"-->
<!--                android:layout_marginTop="4dp">-->

<!--                <ImageView-->
<!--                    android:layout_width="13dp"-->
<!--                    android:layout_height="13dp"-->
<!--                    android:src="@drawable/ic_location_gray"-->
<!--                    app:tint="@color/neutral_black" />-->

<!--                <TextView-->
<!--                    android:id="@+id/locationText"-->
<!--                    android:layout_width="wrap_content"-->
<!--                    android:layout_height="wrap_content"-->
<!--                    android:layout_marginStart="4dp"-->
<!--                    android:text="ABC Boulevard, No. 123"-->
<!--                    android:maxLines="1"-->
<!--                    android:ellipsize="end"-->
<!--                    android:textSize="10sp"-->
<!--                    android:fontFamily="@font/poppins_light"-->
<!--                    android:textColor="@color/neutral_black"/>-->
<!--            </LinearLayout>-->

            <!-- Product Price -->
            <TextView
                android:id="@+id/productPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="$19.99"
                android:textSize="14sp"
                android:fontFamily="@font/poppins_regular"
                android:textColor="@color/neutral_black" />

            <!-- Product Description -->
<!--            <TextView-->
<!--                android:id="@+id/productDescription"-->
<!--                android:layout_width="match_parent"-->
<!--                android:layout_height="wrap_content"-->
<!--                android:layout_marginTop="4dp"-->
<!--                android:text="This is a short description of the product, giving the user a quick overview of the key features and benefits."-->
<!--                android:textSize="12sp"-->
<!--                android:fontFamily="@font/poppins_light"-->
<!--                android:textColor="@color/neutral_black"-->
<!--                android:maxLines="2"-->
<!--                android:ellipsize="end"/>-->

            <!-- Category, Condition, and Date Layout aligned to the end -->

            <!-- Product Category -->
            <TextView
                android:id="@+id/productCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Category"
                android:textSize="10sp"
                android:fontFamily="@font/poppins_light"
                android:textColor="@color/neutral_black"
                android:layout_marginEnd="8dp"/>

            <!-- Product Condition -->
            <TextView
                android:id="@+id/productCondition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Condition"
                android:textSize="10sp"
                android:fontFamily="@font/poppins_light"
                android:textColor="@color/neutral_black"
                android:layout_marginEnd="8dp"/>

            <!-- Product Date aligned to the end -->
            <TextView
                android:id="@+id/productDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12/11/2024"
                android:textSize="10sp"
                android:fontFamily="@font/poppins_light"
                android:textColor="@color/neutral_black"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
