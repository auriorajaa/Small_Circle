<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neutral_white">

    <!-- ScrollView untuk memungkinkan halaman di-scroll -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp">

            <!-- Search Bar -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/searchBar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/medium_button_height"
                app:cardCornerRadius="8dp"
                android:layout_marginBottom="16dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                app:boxStrokeColor="@android:color/black"
                app:boxCornerRadiusTopStart="8dp"
                app:boxCornerRadiusTopEnd="8dp"
                app:boxCornerRadiusBottomStart="8dp"
                app:boxCornerRadiusBottomEnd="8dp"
                android:backgroundTint="@color/neutral_white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/quantum_ic_search_grey600_24"
                        app:tint="@color/neutral_grey"/>

                    <EditText
                        android:id="@+id/searchText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Find what you're looking for..."
                        android:textSize="@dimen/dimen_small_text_size"
                        android:fontFamily="@font/poppins_regular"
                        android:textColor="@color/neutral_black"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Location Section -->
            <LinearLayout
                android:id="@+id/locationSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_below="@id/searchBar"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_location_gray"
                    app:tint="@color/neutral_black"/>

                <TextView
                    android:id="@+id/locationText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:paddingTop="2dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:layout_gravity="bottom"
                    android:text="Within 10km of Jl. ABC No. 12"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textSize="@dimen/dimen_small_text_size"
                    android:fontFamily="@font/poppins_light"
                    android:textColor="@color/neutral_black"/>

                <!-- Next icon aligned to the right end -->
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_next_gray"
                    app:tint="@color/neutral_black"/>
            </LinearLayout>

            <!-- Categories Header -->
            <TextView
                android:id="@+id/categoriesHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/locationSection"
                android:text="Categories"
                android:textSize="24sp"
                android:textColor="@color/neutral_black"
                android:fontFamily="@font/poppins_bold"
                android:layout_marginBottom="10dp"/>

            <!-- Categories RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/categoriesRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/categoriesHeader"
                tools:listitem="@layout/row_category"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                android:nestedScrollingEnabled="false"
                android:orientation="horizontal"/>

            <!-- Categories Header -->
            <TextView
                android:id="@+id/productsHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/categoriesRecyclerView"
                android:text="Near You"
                android:textSize="16sp"
                android:textColor="@color/neutral_black"
                android:fontFamily="@font/poppins_regular"
                android:layout_marginBottom="10dp"/>

            <!-- Products RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/productsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/productsHeader"
                tools:listitem="@layout/row_product"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="2"/>
        </RelativeLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
