<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neutral_white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Profile Header Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">

            <!-- Profile Image and ProgressBar in a FrameLayout -->
            <FrameLayout
                android:layout_width="92dp"
                android:layout_height="92dp">

                <!-- Profile Image -->
                <com.makeramen.roundedimageview.RoundedImageView
                    android:id="@+id/profileImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_person_black"
                    app:riv_corner_radius="8dp"
                    android:background="@drawable/profile_image_background"
                    android:scaleType="centerCrop"/>

                <!-- ProgressBar for loading indication -->
                <ProgressBar
                    android:id="@+id/loadingSpinner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Profile Info Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="16dp"
                android:layout_gravity="center_vertical">

                <!-- Profile Name -->
                <TextView
                    android:id="@+id/profileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="John Doe"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/neutral_black"
                    android:fontFamily="@font/poppins_bold"/>

                <!-- Account Status Wrapper -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">

                    <!-- Account Status Text -->
                    <TextView
                        android:id="@+id/accountStatusText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semi_bold"
                        android:text="Not Verified"
                        android:textColor="@color/accent_red"
                        android:textSize="12sp"/>

                    <!-- Verified Icon -->
                    <ImageView
                        android:id="@+id/verifiedIcon"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="4dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_verified_blue"
                        android:layout_marginBottom="2dp"
                        android:visibility="gone"
                        android:baselineAlignBottom="true"/>
                </LinearLayout>


                <!-- Member Since -->
                <TextView
                    android:id="@+id/memberSinceText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_light"
                    android:text="Member since: dd/MM/yyyy"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Info Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Email Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Email"
                    android:fontFamily="@font/poppins_regular"
                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/emailText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_light"
                    android:text="email@example.com"
                    android:maxLines="1"
                    android:gravity="end"
                    android:layout_gravity="end"
                    android:textSize="12sp"
                    android:maxWidth="200dp"
                    android:ellipsize="end"
                    android:singleLine="true"/>
            </LinearLayout>

            <!-- Phone Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Phone"
                    android:fontFamily="@font/poppins_regular"
                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/phoneText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_light"
                    android:text="+62 123 456 789"
                    android:gravity="end"
                    android:textSize="12sp"/>
            </LinearLayout>

            <!-- Date of Birth Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Date of Birth"
                    android:fontFamily="@font/poppins_regular"
                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/dateOfBirthText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_light"
                    android:text="dd/MM/yyyy"
                    android:gravity="end"
                    android:textSize="12sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Buttons Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- Edit Profile Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/edit_profile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/medium_button_height"
                android:text="Edit Profile"
                android:layout_marginBottom="12dp"
                android:backgroundTint="@color/neutral_black"
                android:textColor="@color/neutral_white"
                android:fontFamily="@font/poppins_regular"
                app:cornerRadius="8dp"/>

            <!-- Change Password Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/change_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/medium_button_height"
                android:text="Change Password"
                android:layout_marginBottom="16dp"
                android:backgroundTint="@color/neutral_white"
                android:textColor="@color/neutral_black"
                android:fontFamily="@font/poppins_regular"
                app:strokeColor="@color/neutral_grey"
                app:strokeWidth="0.5dp"
                app:cornerRadius="8dp"/>

            <!-- Logout TextView -->
            <TextView
                android:id="@+id/logout_text_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Logout"
                android:textColor="@color/accent_red"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins_bold"
                android:layout_gravity="center"
                android:layout_marginBottom="12dp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
