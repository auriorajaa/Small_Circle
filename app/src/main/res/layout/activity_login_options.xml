<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neutral_white"
    tools:context=".activity.LoginOptionsActivity">

    <!-- Toolbar Layout -->
    <RelativeLayout
        android:id="@+id/toolbar_relative_layout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/medium_toolbar_height"
        android:background="@color/neutral_white"
        android:elevation="4dp"
        tools:ignore="MissingConstraints">

        <!-- Back Button -->
        <ImageButton
            android:id="@+id/close_button"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/ic_close_gray"
            android:background="@android:color/transparent"
            android:contentDescription="Close"
            android:layout_alignParentStart="true"/>
    </RelativeLayout>

    <!-- App Name -->
    <TextView
        android:id="@+id/app_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Small Circle"
        android:textSize="42dp"
        android:textStyle="bold"
        android:textColor="@color/neutral_black"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar_relative_layout"
        android:layout_marginStart="22dp"
        android:fontFamily="@font/poppins_bold"
        android:layout_marginTop="32dp"/>

    <!-- App Description -->
    <TextView
        android:id="@+id/app_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Connect with others, share your interests, and discover unique items and opportunities within a trusted, close community."
        android:textSize="@dimen/dimen_small_text_size"
        app:layout_constraintStart_toStartOf="@id/app_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/app_name"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/poppins_light"
        android:layout_marginEnd="24dp"/>

    <!-- Button Layout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp"
        android:layout_margin="10.5dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Google Login Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/login_with_google_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Continue with Google"
            android:textSize="@dimen/dimen_small_text_size"
            app:icon="@drawable/ic_google"
            android:minHeight="@dimen/medium_button_height"
            android:layout_marginBottom="12dp"
            android:backgroundTint="@color/neutral_black"
            android:fontFamily="@font/poppins_regular"
            app:cornerRadius="8dp"/>

        <!-- Phone Login Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/login_with_phone_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Continue with Phone"
            app:icon="@drawable/ic_call_white"
            android:textSize="@dimen/dimen_small_text_size"
            android:minHeight="@dimen/medium_button_height"
            android:layout_marginBottom="12dp"
            android:backgroundTint="@color/neutral_black"
            android:fontFamily="@font/poppins_regular"
            app:cornerRadius="8dp"/>

        <!-- Email Login Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/login_with_email_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Continue with Email"
            app:icon="@drawable/ic_email_white"
            android:textSize="@dimen/dimen_small_text_size"
            android:minHeight="@dimen/medium_button_height"
            android:layout_marginBottom="12dp"
            android:backgroundTint="@color/neutral_black"
            android:fontFamily="@font/poppins_regular"
            app:cornerRadius="8dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
