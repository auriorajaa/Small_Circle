<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/neutral_white"
    tools:context=".MainActivity">
    
    <RelativeLayout
            android:id="@+id/toolbar_relative_layout"
            android:layout_width="match_parent"
            android:layout_height="@dimen/medium_toolbar_height">
        
        <TextView
                android:id="@+id/toolbar_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                style="@style/TextAppearance.MaterialComponents.Body1"
                android:textColor="@color/neutral_black"
                android:text="Home"/>
        
        <View
                android:layout_alignParentBottom="true"
                android:layout_width="match_parent"
                android:layout_height="1.5dp"
                android:background="@color/neutral_grey"/>
        
    </RelativeLayout>

    <FrameLayout
            android:id="@+id/fragment_frame_layout"
            android:layout_below="@id/toolbar_relative_layout"
            android:layout_above="@id/view_offset_bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    
    <View
            android:id="@+id/view_offset_bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/neutral_black"
            android:layout_above="@id/bottom_navigation"/>

    <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            app:menu="@menu/menu_bottom"
            android:background="@color/neutral_black"
            android:elevation="3dp"
            app:itemTextColor="@color/bottom_nav_item_color"
            app:itemIconTint="@color/bottom_nav_item_color"
            android:paddingBottom="8dp"
            app:labelVisibilityMode="labeled"
            app:itemActiveIndicatorStyle="@style/ShapeAppearance.Material3.Corner.None"
            app:itemTextAppearanceActive="@style/CustomBottomNavigationView"
            app:itemTextAppearanceInactive="@style/CustomBottomNavigationView"/>


    <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="58dp"
            android:src="@drawable/ic_add_white"
            android:backgroundTint="@color/neutral_white"
            android:elevation="18dp"
            app:tint="@color/neutral_black"
            app:borderWidth="0dp"/>

</RelativeLayout>