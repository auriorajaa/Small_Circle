<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/forgot_password_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neutral_white"
    tools:context=".ForgotPasswordActivity">

    <!-- Toolbar Layout -->
    <RelativeLayout
        android:id="@+id/toolbar_relative_layout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/medium_toolbar_height"
        android:background="@color/neutral_white"
        android:elevation="4dp">

        <!-- Back Button -->
        <ImageButton
            android:id="@+id/toolbar_back_button"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/ic_back_gray"
            android:background="@android:color/transparent"
            android:contentDescription="Back"
            android:layout_alignParentStart="true"/>
    </RelativeLayout>

    <!-- Main content starts here -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp"
        android:layout_margin="10.5dp"
        android:layout_below="@id/toolbar_relative_layout">

        <!-- Forgot Password Heading -->
        <TextView
            android:id="@+id/forgot_password_heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Forgot Password"
            android:fontFamily="@font/poppins_bold"
            android:textSize="42dp"
            android:textStyle="bold"
            android:textColor="@color/neutral_black"
            android:layout_marginBottom="8dp"/>

        <!-- Description Text -->
        <TextView
            android:id="@+id/forgot_password_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enter your email to receive instructions to reset your password."
            android:textSize="14sp"
            android:textColor="@color/neutral_grey"
            android:fontFamily="@font/poppins_light"
            android:layout_marginBottom="24dp"/>

        <!-- Email Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/email_text_input_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:boxStrokeColor="@android:color/black"
            android:layout_marginBottom="16dp"
            app:boxCornerRadiusTopStart="8dp"
            app:boxCornerRadiusTopEnd="8dp"
            app:boxCornerRadiusBottomStart="8dp"
            app:boxCornerRadiusBottomEnd="8dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/email_edit_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="10dp"
                android:textSize="15sp"
                android:fontFamily="@font/poppins_regular"
                android:drawableStart="@drawable/ic_email_black"
                android:hint="Enter your email"
                android:inputType="textEmailAddress"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Submit Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/submit_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Submit"
            android:fontFamily="@font/poppins_regular"
            android:textAllCaps="false"
            android:textColor="@color/neutral_white"
            android:minHeight="@dimen/medium_button_height"
            app:cornerRadius="8dp"/>
    </LinearLayout>
</RelativeLayout>
