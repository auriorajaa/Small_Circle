<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.SmallCircle" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="colorPrimary">@color/neutral_black</item>
        <item name="colorOnPrimary">@color/neutral_white</item>

<!--        <item name="android:colorBackground">@color/neutral_white</item>-->

    </style>

    <!-- Custom Theme for MaterialAlertDialog -->
    <style name="AlertDialogTheme" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <!-- Apply custom styles for the buttons -->
        <item name="buttonBarNegativeButtonStyle">@style/NegativeButtonStyle</item>
        <item name="buttonBarPositiveButtonStyle">@style/PositiveButtonStyle</item>
        <item name="android:background">#FFFFFF</item> <!-- Set background color to white -->
        <item name="android:textColor">#000000</item> <!-- Set default text color to black -->

        <!-- Apply custom font for dialog title and message -->
        <item name="android:fontFamily">@font/poppins_regular</item> <!-- Set custom font -->
    </style>

    <!-- Custom style for Negative Button (Red text and custom font) -->
    <style name="NegativeButtonStyle" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/accent_red</item> <!-- Red text color for negative button -->
        <item name="android:fontFamily">@font/poppins_regular</item> <!-- Custom font -->
    </style>

    <!-- Custom style for Positive Button (Blue text and custom font) -->
    <style name="PositiveButtonStyle" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/neutral_black</item> <!-- Blue text color for positive button -->
        <item name="android:fontFamily">@font/poppins_regular</item> <!-- Custom font -->
    </style>

    <style name="ViewPagerTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Set background colors to neutral white -->
        <item name="colorSurface">@color/neutral_white</item>
        <item name="android:windowBackground">@color/neutral_white</item>

        <!-- Set default text color to black on surface -->
        <item name="colorOnSurface">@color/neutral_black</item>
        <!-- Set primary text color in this theme to black -->
        <item name="android:textColorPrimary">@color/neutral_black</item>
        <!-- Set secondary text color to black (for secondary text) -->
        <item name="android:textColorSecondary">@color/neutral_black</item>
    </style>

    <style name="CustomTabLayout" parent="Widget.MaterialComponents.TabLayout">
        <!-- Background color of TabLayout -->
        <item name="tabBackground">@color/neutral_white</item>
        <!-- Tab text color for selected and unselected states -->
        <item name="tabTextColor">@color/neutral_black</item>
        <item name="tabSelectedTextColor">@color/neutral_black</item>
        <!-- Tab indicator color (underline below the selected tab) -->
        <item name="tabIndicatorColor">@color/neutral_black</item>
        <!-- Disable all caps for tab text -->
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
        <!-- Set custom font family -->
        <item name="tabTextAppearance">@style/CustomTabTextAppearance</item>
    </style>

    <!-- Define custom text appearance for the TabLayout tabs -->
    <style name="CustomTabTextAppearance" parent="TextAppearance.Design.Tab">
        <item name="android:fontFamily">@font/poppins_regular</item>
        <item name="textAllCaps">false</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- In styles.xml -->
    <style name="CustomFloatingActionButton" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="backgroundTint">@color/neutral_white</item>
        <item name="rippleColor">@color/neutral_black</item>
    </style>

    <style name="CustomDatePickerDialog" parent="ThemeOverlay.MaterialComponents.Dialog">
        <!-- Primary color untuk header dan selected date -->
        <item name="colorPrimary">@color/neutral_black</item>
        <item name="colorAccent">@color/neutral_black</item>

        <!-- Warna background -->
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackground">@color/neutral_white</item>
        <item name="background">@color/neutral_white</item>

        <!-- Hapus background dim/overlay -->
        <item name="android:backgroundDimEnabled">false</item>

        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/neutral_black</item>
        <item name="android:textColorSecondary">@color/neutral_black</item>
        <item name="android:textColor">@color/neutral_black</item>

        <!-- Calendar styles -->
        <item name="materialCalendarStyle">@style/CustomCalendarStyle</item>
        <item name="materialCalendarFullscreenTheme">@style/CustomCalendarStyle</item>
    </style>

    <style name="CustomCalendarStyle" parent="@style/ThemeOverlay.MaterialComponents.MaterialCalendar">
        <item name="android:colorBackground">@color/neutral_white</item>
        <item name="colorSurface">@color/neutral_white</item>
    </style>

    <style name="WhitePopupMenu" parent="@style/Widget.AppCompat.PopupMenu">
        <item name="android:background">@color/neutral_white</item>
    </style>

    <style name="WhiteDropdownMenu" parent="Widget.AppCompat.DropDownItem.Spinner">
        <item name="android:background">@color/neutral_white</item>
    </style>

    <!-- Theme to set white background for image selection dialogs -->
    <style name="ImagePickerDialogTheme" parent="Theme.MaterialComponents.DayNight.BottomSheetDialog">
        <item name="colorPrimary">@color/neutral_white</item>
        <item name="colorPrimaryVariant">@color/neutral_white</item>
        <item name="colorOnPrimary">@color/neutral_black</item>
    </style>

    <style name="PopupMenuWhiteBackground" parent="ThemeOverlay.AppCompat.Light">
        <item name="android:colorBackground">@color/neutral_white</item>
        <item name="android:popupBackground">@color/neutral_white</item>
    </style>

    <style name="Theme.SmallCircle" parent="Base.Theme.SmallCircle"/>
</resources>